<main class="site-main site-main--narrow site-main--reading" id="reading-main">
  <article class="page-about">
    <div class="reading-dock-zone">
      <header class="page-about__header reading-mast">
        <div class="reading-mast__cluster">
          <div class="page-about__brand">
            <h1 class="page-about__name"><%= page.title || config.title %></h1>
          </div>
          <% if (page.subtitle) { %><p class="page-about__tagline"><%= page.subtitle %></p><% } %>
        </div>
      </header>
      <div class="reading-head-space" aria-hidden="true"></div>
    </div>
    <div class="reading-body-anchor" id="reading-body" tabindex="-1">
      <div class="page-content reading-body"><%- partial('_partial/content', {content: page.content || ''}) %></div>
    </div>
    <%- partial('_partial/signature') %>
  </article>
</main>

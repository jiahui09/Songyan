<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title ? page.title + ' · ' + config.title : config.title %></title>
  <% if (config.description) { %>
  <meta name="description" content="<%= config.description %>">
  <% } %>
  <link rel="icon" type="image/svg+xml" href="<%= url_for('/images/seal-favicon.svg') %>">
  <link rel="stylesheet" href="<%= url_for('/css/fonts.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/tokens.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/base.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/components.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/layouts.css') %>">
  <link rel="stylesheet" href="<%= url_for('/css/reading.css') %>">
</head>
<% var readingPage = page.layout === 'post' || page.layout === 'page' || page.layout === 'about'; %>
<body<% if (readingPage) { %> class="reading-page"<% } %>>
  <% if (readingPage) { %><a href="#reading-main" class="reading-skip"><%= theme.labels.skip_content %></a><% } %>
  <%- partial('_partial/header') %>

  <%- body %>

  <%- partial('_partial/footer') %>

  <script src="<%= url_for('/js/main.js') %>"></script>
  <script src="<%= url_for('/js/seal.js') %>"></script>
  <% if (readingPage) { %>
  <%- partial('_partial/reading-tools') %>
  <script src="<%= url_for('/js/reading.js') %>"></script>
  <% } %>
  <% if (page.layout === 'post' && page.type === 'ci') { %>
  <script src="<%= url_for('/js/poem-slip.js') %>"></script>
  <% } %>
</body>
</html>

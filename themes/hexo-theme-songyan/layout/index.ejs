<%
  var cfg = theme.home || {};
  var posts = page.posts || site.posts.sort('-date');
%>
<main class="site-main">
  <section class="home-epigraph" aria-label="<%= theme.theme_name %>">
    <% if (cfg.hero_verse) { %><p class="home-epigraph__text"><%= cfg.hero_verse %></p><% } %>
    <% if (cfg.hero_source) { %><p class="home-epigraph__source"><%= cfg.hero_source %></p><% } %>
  </section>
  <section class="home-stream" aria-label="<%= theme.labels.post %>">
    <% posts.forEach(function (post) {
      var category = post.categories && post.categories.length ? post.categories.toArray()[0].name : '';
      var eyebrow = post.cipai || category || (post.type === 'ci' ? theme.archive.categories.ci : theme.labels.post);
      var text = strip_html((post.excerpt || post.content || '').replace(/<rt\b[^>]*>[\s\S]*?<\/rt>/gi, '').replace(/<rp\b[^>]*>[\s\S]*?<\/rp>/gi, ''));
    %>
    <article class="post-item enter">
      <span class="post-item__eyebrow"><%= eyebrow %></span>
      <h2 class="post-title"><a href="<%= url_for(post.path) %>"><%= post.title || config.title %></a></h2>
      <div class="post-meta">
        <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><span class="post-meta__date-gregorian"><%= date(post.date, 'YYYY.MM.DD') %></span></time>
        <% if (category || post.type === 'ci') { %><span class="sep" aria-hidden="true">·</span><span><%= post.type === 'ci' ? theme.archive.categories.ci : category %></span><% } %>
        <% if (post.tags && post.tags.length) { %><span class="sep" aria-hidden="true">·</span><span class="post-meta__tags"><% post.tags.forEach(function (tag) { %><span class="post-meta__tag-item">#<%= tag.name %></span><% }); %></span><% } %>
      </div>
      <% if (text) { %><p class="post-excerpt"><%= truncate(text, {length: 120, separator: ''}) %></p><% } %>
      <div class="read-more-wrapper"><a href="<%= url_for(post.path) %>" class="read-more-btn"><span><%= theme.labels.read_more %></span><span class="arrow" aria-hidden="true">→</span></a></div>
    </article>
    <% }); %>
    <% if (!posts.length) { %><p><%= theme.labels.empty %></p><% } %>
    <%- partial('_partial/pagination') %>
  </section>
</main>

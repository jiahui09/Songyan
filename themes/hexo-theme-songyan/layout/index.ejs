<%
  /**
   * 首页（卷首 · 归流双轨）：移植自静态原型 prototype/index.html
   * 文案与路径全部来自 theme.* 配置；文章数据来自 Hexo site.posts
   * 取消四板块拼盘：全站文章按日期归为一条单列流，
   * 仅按「诗词体 / 文章体」两轨呈现（诗文双轨）。
   */
  var homeCfg = theme.home || {};
  var sectionsCfg = homeCfg.sections || {};
  var labels = theme.labels || {};
  var streamLimit = homeCfg.stream_limit || 9;

  // 归流：全部文章按日期倒序，统一限额截断（不分卷）
  var streamPosts = site.posts.sort('-date').limit(streamLimit);

  // 摘要：优先 Hexo excerpt，缺失时回退到正文截断（不伪造内容）
  function cardExcerpt(post) {
    var text = strip_html(post.excerpt || post.content || '');
    return text ? truncate(text, { length: 72, separator: '' }) : '';
  }

  // 干支纪年：以立春（近似 2/4）为界换算年柱（纯计算，不依赖外部历法库）
  var STEMS = '甲乙丙丁戊己庚辛壬癸';
  var BRANCHES = '子丑寅卯辰巳午未申酉戌亥';
  function ganzhiYear(d) {
    var y = d.getFullYear();
    var lichun = Math.floor(y * 0.2422 + 3.87) - Math.floor((y - 1) / 4);
    if (d.getMonth() < 1 || (d.getMonth() === 1 && d.getDate() < lichun)) y -= 1;
    var i = (y - 4) % 60;
    if (i < 0) i += 60;
    return STEMS.charAt(i % 10) + BRANCHES.charAt(i % 12) + '年';
  }

  // 二十四节气：21 世纪近似公式（day = [Y*0.2422+C] - [(Y-1)/4]，适用 2000–2099）
  var TERMS = ['小寒','大寒','立春','雨水','惊蛰','春分','清明','谷雨',
               '立夏','小满','芒种','夏至','小暑','大暑','立秋','处暑',
               '白露','秋分','寒露','霜降','立冬','小雪','大雪','冬至'];
  var TERM_C = [5.4055,20.12,3.87,18.73,5.63,20.646,4.81,20.1,5.52,21.04,5.678,21.37,
                7.108,22.83,7.5,23.13,7.646,23.042,8.318,23.438,7.438,22.36,7.18,21.94];
  function solarTerm(d) {
    var y = d.getFullYear(), m = d.getMonth(), day = d.getDate();
    var Y = y - 1900;
    var t1 = Math.floor(Y * 0.2422 + TERM_C[m * 2]) - Math.floor((Y - 1) / 4);
    var t2 = Math.floor(Y * 0.2422 + TERM_C[m * 2 + 1]) - Math.floor((Y - 1) / 4);
    if (day >= t2) return TERMS[m * 2 + 1];
    if (day >= t1) return TERMS[m * 2];
    // 当日早于本月首节气：归上月「气」（每月第二个节气名）
    var pm = (m + 11) % 12;
    return TERMS[pm * 2 + 1];
  }

  // 朱红题头：词牌名最高优先级 → 主分类 → 文稿兜底（每条必有，压阵标题）
  function eyebrowLabel(post) {
    if (post.cipai) return post.cipai;
    if (post.categories && post.categories.length) {
      return post.categories.data[0].name;
    }
    if (post.type === 'ci') {
      var ciCfg = sectionsCfg.ci;
      return (ciCfg && ciCfg.menu) || labels.post || '';
    }
    return labels.post || '';
  }

  // 元信息分类：诗词归「词卷」聚合，文章显示主分类，兜底 labels.post
  function metaCategory(post) {
    if (post.type === 'ci') {
      var ciCfg = sectionsCfg.ci;
      return (ciCfg && ciCfg.menu) || labels.post || '';
    }
    if (post.categories && post.categories.length) {
      return post.categories.data[0].name;
    }
    return labels.post || '';
  }

  // 诗词体摘句：正文按句读切分，取前三句（不伪造内容，不足则少显示）
  function ciVerseLines(post) {
    var text = strip_html(post.content || '').replace(/\s+/g, '');
    if (!text) return [];
    return text
      .split(/[，。？！；、…]+/)
      .map(function (s) { return s.trim(); })
      .filter(Boolean)
      .slice(0, 3);
  }


  // 诗文双轨判定：ci 且有词牌走诗词体，其余（随笔/技术/项目）统一文章体
  function isVerse(post) {
    return post.type === 'ci' && !!post.cipai;
  }
%>
<main class="site-main">

  <!-- 卷首 Header（典雅词句 + 盖下动效印章） -->
  <section class="hero-scroll" aria-label="卷首词句">
    <% if (homeCfg.hero_verse) { %>
    <p class="hero-scroll__verse"><%= homeCfg.hero_verse %></p>
    <% } %>
    <div class="hero-scroll__seal-brand">
      <span class="seal seal--brand seal-stamp-once" aria-hidden="true">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <% var sealChars = theme.author.seal_chars || []; %>
          <rect x="6" y="6" width="88" height="88" rx="3" fill="none" stroke="var(--seal-color)" stroke-width="1.5"/>
          <rect x="10" y="10" width="80" height="80" rx="2" fill="none" stroke="var(--seal-color)" stroke-width="0.6" opacity="0.5"/>
          <g fill="var(--seal-color)" font-family="var(--font-seal)" font-size="28" font-weight="bold" text-anchor="middle" dominant-baseline="central">
            <text x="65" y="34"><%= sealChars[0] %></text>
            <text x="65" y="66"><%= sealChars[1] %></text>
            <text x="35" y="34"><%= sealChars[2] %></text>
            <text x="35" y="66"><%= sealChars[3] %></text>
          </g>
        </svg>
      </span>
    </div>
    <% if (homeCfg.hero_tagline) { %>
    <p class="hero-scroll__sub"><%= homeCfg.hero_tagline %></p>
    <% } %>
  </section>

  <!-- 归流：单列双轨（诗词体 ci / 文章体 post），如一卷自然展开 -->
  <section class="home-stream" aria-label="文章归流">
    <% streamPosts.forEach(function (post) {
      var isCi = isVerse(post);
      var dateStr = date(post.date, 'YYYY-MM-DD');
      var dateDot = date(post.date, 'YYYY.MM.DD');
      var eyebrow = eyebrowLabel(post);
      var cat = metaCategory(post);
      var ganzhi = ganzhiYear(post.date.toDate()) + ' ' + solarTerm(post.date.toDate());
      var tags = (post.tags && post.tags.length) ? post.tags.toArray() : [];
      var verse = isCi ? ciVerseLines(post) : [];
      var excerpt = isCi ? '' : cardExcerpt(post);
    %>
    <% if (isCi) { %>
    <!-- 【诗词体】朱红词牌题头 + 居中宋式摘句断句留白 -->
    <article class="stream-item stream-item--ci enter">
      <header class="stream-item__head">
        <p class="stream-item__eyebrow"><%= eyebrow %></p>
        <h3 class="stream-item__title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
      </header>
      <% if (verse.length) { %>
      <div class="stream-item__verse">
        <% verse.forEach(function (line) { %>
        <span class="stream-item__verse-line"><%= line %></span>
        <% }); %>
      </div>
      <% } %>
      <p class="stream-item__meta">
        <time datetime="<%= dateStr %>"><span class="stream-item__date-gregorian"><%= dateDot %></span></time>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span><%= ganzhi %></span>
        <% if (cat) { %>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span><%= cat %></span>
        <% } %>
        <% if (tags.length) { %>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span class="stream-item__tags">
          <% tags.forEach(function (tag) { %>
          <span class="stream-item__tag-item">#<%= tag.name %></span>
          <% }); %>
        </span>
        <% } %>
      </p>
    </article>
    <% } else { %>
    <!-- 【文章体】随笔/技术/项目等一视同仁（type: post）：朱红题头 · 汉字元信息 · 纯文本摘要 -->
    <article class="stream-item stream-item--prose enter">
      <header class="stream-item__head">
        <p class="stream-item__eyebrow"><%= eyebrow %></p>
        <h3 class="stream-item__title"><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
      </header>
      <p class="stream-item__meta">
        <time datetime="<%= dateStr %>"><span class="stream-item__date-gregorian"><%= dateDot %></span></time>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span><%= ganzhi %></span>
        <% if (cat) { %>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span><%= cat %></span>
        <% } %>
        <% if (tags.length) { %>
        <span class="meta-separator" aria-hidden="true">·</span>
        <span class="stream-item__tags">
          <% tags.forEach(function (tag) { %>
          <span class="stream-item__tag-item">#<%= tag.name %></span>
          <% }); %>
        </span>
        <% } %>
      </p>
      <% if (excerpt) { %>
      <p class="stream-item__excerpt"><%= excerpt %></p>
      <% } %>
    </article>
    <% } %>
    <% }); %>
  </section>

</main>

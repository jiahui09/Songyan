<%
  var cfg = theme.archive;
  var collection = (page.category || page.tag || page.year) && page.posts ? page.posts : site.posts;
  var ordered = collection.sort('-date').toArray();
  var recentCount = Math.max(0, Number(cfg.recent) || 3);
  var recent = ordered.slice(0, recentCount);
  var groups = {};
  ordered.forEach(function (post) {
    var year = date(post.date, 'YYYY');
    var month = date(post.date, 'MM');
    if (!groups[year]) groups[year] = {};
    (groups[year][month] || (groups[year][month] = [])).push(post);
  });
  function sectionOf(post) {
    if (post.type === 'ci') return 'ci';
    var names = post.categories ? post.categories.toArray().map(function (cat) { return cat.name; }) : [];
    return Object.keys(cfg.category_names).find(function (key) { return cfg.category_names[key].some(function (name) { return names.includes(name); }); }) || cfg.fallback_category || 'essay';
  }
  var termDays = [5.4055, 20.12, 3.87, 18.73, 5.63, 20.646, 4.81, 20.1, 5.52, 21.04, 5.678, 21.37, 7.108, 22.83, 7.5, 23.13, 7.646, 23.042, 8.318, 23.438, 7.438, 22.36, 7.18, 21.94];
  function solarTermsFor(year, month, posts) {
    var names = (cfg.solar_terms || {})[Number(month)] || [];
    var offset = (Number(month) - 1) * 2;
    var yearOffset = Number(year) - 2000;
    var candidates = names.map(function (name, index) {
      var ordinal = offset + index;
      var day = Math.floor((yearOffset * 0.2422) + termDays[ordinal]) - Math.floor((yearOffset - 1) / 4);
      return {name: name, day: day};
    });
    var mapped = {};
    posts.forEach(function (post) {
      var day = Number(date(post.date, 'D'));
      var nearest = candidates.reduce(function (best, term) {
        return Math.abs(term.day - day) < Math.abs(best.day - day) ? term : best;
      }, candidates[0]);
      if (nearest && Math.abs(nearest.day - day) <= 7) mapped[nearest.name] = true;
    });
    return candidates.filter(function (term) { return mapped[term.name]; }).map(function (term) { return term.name; });
  }
  var digits = '〇一二三四五六七八九';
  var stems = '甲乙丙丁戊己庚辛壬癸';
  var branches = '子丑寅卯辰巳午未申酉戌亥';
  var yearMarks = Object.keys(groups).sort().reverse();
  var timelinePosts = ordered.map(function (post) {
    return {
      date: date(post.date, 'YYYY-MM-DD'),
      year: date(post.date, 'YYYY'),
      month: date(post.date, 'M'),
      day: date(post.date, 'D'),
      category: sectionOf(post),
      solarTerm: post.solar_term || '',
      title: post.title || config.title,
      href: url_for(post.path)
    };
  });
%>
<main class="site-main site-main--archive">
  <div class="archive-cover-zone">
  <header class="archive-head">
    <div class="archive-head__mast">
      <h1 class="archive-head__title"><%= cfg.title %><% if (page.category || page.tag) { %> · <%= page.category || page.tag %><% } %></h1>
      <p class="archive-head__count" role="status"><%= cfg.count_prefix %>：<span data-archive-count><%= ordered.length %></span> <%= cfg.count_suffix %></p>
    </div>
  </header>
  <div class="archive-intro">
    <% if (recent.length) { %>
    <ol class="archive-recent" aria-label="<%= cfg.recent_label %>">
      <% recent.forEach(function (post) {
        var key = sectionOf(post);
      %>
      <li class="archive-recent__item">
        <a href="<%= url_for(post.path) %>" class="archive-recent__link">
          <span class="archive-recent__rubric"><%= cfg.categories[key] %></span>
          <span class="archive-recent__sep" aria-hidden="true">·</span>
          <span class="archive-recent__title"><%= post.title || config.title %></span>
        </a>
        <time class="archive-recent__date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%- partial('_partial/han-date', {value: post.date}) %></time>
      </li>
      <% }); %>
    </ol>
    <% } %>
    <div class="archive-head-space" aria-hidden="true"></div>
  </div>
  </div>
  <div class="archive-toolbar">
    <div class="archive-legend" role="group" aria-label="<%= cfg.filter_label %>">
      <% Object.keys(cfg.categories).forEach(function (key) { %><button type="button" class="archive-legend__item" data-cat-filter="<%= key %>" aria-pressed="false"><span class="archive-legend__dot archive-legend__dot--<%= key %>"></span><%= cfg.categories[key] %></button><% }); %>
    </div>
  </div>
  <% if (ordered.length) { %>
  <section class="scroll-viewport archive-cylinder" id="archive-chrono" aria-label="<%= cfg.title %>" data-testid="timeline-viewport" data-archive-nodes="<%= encodeURIComponent(JSON.stringify(timelinePosts)) %>">
    <svg class="rail-svg" aria-hidden="true">
      <defs>
        <linearGradient id="archive-rail-stroke" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--ink-rail)" stop-opacity="0" />
          <stop offset="14%" stop-color="var(--ink-rail)" />
          <stop offset="50%" stop-color="var(--ink-rail)" />
          <stop offset="86%" stop-color="var(--ink-rail)" />
          <stop offset="100%" stop-color="var(--ink-rail)" stop-opacity="0" />
        </linearGradient>
        <linearGradient id="archive-rail-echo" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="var(--ink-rail-echo)" stop-opacity="0" />
          <stop offset="18%" stop-color="var(--ink-rail-echo)" />
          <stop offset="50%" stop-color="var(--ink-rail-echo)" />
          <stop offset="82%" stop-color="var(--ink-rail-echo)" />
          <stop offset="100%" stop-color="var(--ink-rail-echo)" stop-opacity="0" />
        </linearGradient>
        <mask id="scroll-edge-mask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
          <linearGradient id="archive-edge-fade" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="black" />
            <stop offset="0.06" stop-color="#333333" />
            <stop offset="0.16" stop-color="white" />
            <stop offset="0.84" stop-color="white" />
            <stop offset="0.94" stop-color="#333333" />
            <stop offset="1" stop-color="black" />
          </linearGradient>
          <rect x="0" y="0" width="1" height="1" fill="url(#archive-edge-fade)" />
        </mask>
      </defs>
      <path class="rail-echo rail-year" />
      <path class="rail-echo rail-echo--upper" />
      <path class="rail-path rail-path--upper" />
      <path class="rail-path rail-path--lower" />
      <path class="rail-echo rail-echo--lower" />
      <line class="rail-center-tick rail-center-tick--upper" />
      <line class="rail-center-tick rail-center-tick--lower" />
    </svg>
    <div class="year-stage" aria-hidden="true"></div>
    <div class="timeline-stage" data-testid="timeline-stage"></div>
  </section>
  <ol class="archive-list" data-archive-list aria-label="<%= cfg.list_label %>">
    <% ordered.forEach(function (post) { var key = sectionOf(post); %>
    <li class="archive-list__item" data-cat="<%= key %>">
      <time class="archive-list__date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%- partial('_partial/han-date', {value: post.date, compact: true}) %></time>
      <span class="archive-list__rubric archive-list__rubric--<%= key %>"><%= cfg.categories[key] %></span>
      <a href="<%= url_for(post.path) %>" class="archive-list__link"><span class="archive-list__title"><%= post.title || config.title %></span></a>
    </li>
    <% }); %>
  </ol>
  <div class="archive-exit-space" aria-hidden="true"></div>
  <p class="archive-empty" data-archive-empty role="status" hidden><%= theme.labels.empty %></p>
  <% } else { %><p class="archive-empty" id="archive-chrono" data-archive-empty role="status" tabindex="-1"><%= theme.labels.empty %></p><% } %>
  <% if (page.category || page.tag || page.year) { %><%- partial('_partial/pagination') %><% } %>
</main>

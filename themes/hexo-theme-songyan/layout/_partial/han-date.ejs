<%
  // 汉字纪日：二〇二六年十月十二日；withYear === false 时只写月日；compact 为「二〇二六年 十月」
  var hanDigits = '〇一二三四五六七八九';
  function hanNumber(n) {
    return n < 10 ? hanDigits[n] : (n < 20 ? '十' : hanDigits[Math.floor(n / 10)] + '十') + (n % 10 ? hanDigits[n % 10] : '');
  }
  var hanYear = date(value, 'YYYY').split('').map(function (n) { return hanDigits[Number(n)]; }).join('') + theme.labels.year;
  var hanMonth = hanNumber(Number(date(value, 'M'))) + theme.labels.month;
  var hanDay = hanMonth + hanNumber(Number(date(value, 'D'))) + theme.labels.day;
  var part = typeof part !== 'undefined' ? part : null;
  var text;
  if (part === 'month') text = hanMonth;
  else if (part === 'day') text = hanNumber(Number(date(value, 'D')));
  else if (typeof compact !== 'undefined' && compact) text = hanYear + ' ' + hanMonth;
  else text = (typeof withYear !== 'undefined' && withYear === false ? '' : hanYear) + hanDay;
%><%= text %>
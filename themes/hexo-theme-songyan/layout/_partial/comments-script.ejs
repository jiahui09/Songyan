<%
  var comments = theme.comments || {};
  var gitalk = comments.gitalk || {};
  var enabled = comments.enable !== false && gitalk.enable && gitalk.clientID && gitalk.clientSecret && gitalk.repo && gitalk.owner;
  var onPost = page.layout === 'post';
  function esc(value) {
    return String(value == null ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'");
  }
%>
<% if (enabled && onPost) { %>
<link rel="stylesheet" href="<%= url_for('/css/gitalk-theme.css') %>">
<script src="https://cdn.jsdelivr.net/npm/gitalk@1/dist/gitalk.min.js" defer></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var mount = document.getElementById('gitalk-container');
  if (!mount || typeof Gitalk === 'undefined') return;
  var id = '<%= esc(gitalk.id || page.path) %>'.slice(0, 50);
  var gitalk = new Gitalk({
    clientID: '<%= esc(gitalk.clientID) %>',
    clientSecret: '<%= esc(gitalk.clientSecret) %>',
    repo: '<%= esc(gitalk.repo) %>',
    owner: '<%= esc(gitalk.owner) %>',
    admin: <%- JSON.stringify(gitalk.admin || [gitalk.owner]) %>,
    id: id,
    distractionFreeMode: <%= gitalk.distractionFreeMode === true %>,
    language: '<%= esc(gitalk.language || config.language || 'zh-CN') %>',
    perPage: <%= Number(gitalk.perPage) || 10 %>,
    pagerDirection: '<%= esc(gitalk.pagerDirection || 'last') %>',
    createIssueManually: <%= gitalk.createIssueManually === true %>,
    proxy: '<%= esc(gitalk.proxy || 'https://cors-anywhere.azm.workers.dev/https://github.com/login/oauth/access_token') %>'
  });
  gitalk.render('gitalk-container');
});
</script>
<% } %>

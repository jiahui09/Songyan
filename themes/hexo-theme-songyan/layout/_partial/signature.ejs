<%
  var sealCfg = theme.seal || {};
  var override = page.seal;
  var text = typeof override === 'string' ? override : override && override.text;
  var style = override && typeof override === 'object' ? override.style : undefined;
  var showSeal = override !== false && sealCfg.enable && sealCfg.locations && sealCfg.locations.post_footer;
  var written = page.date || page.updated;
  var vertical = typeof variant !== 'undefined' && variant === 'vertical';
  var withSlip = typeof slip !== 'undefined' && slip;
%>
<div class="post-signature<%= vertical ? ' post-signature--vertical' : '' %>"<%= vertical ? ' data-ci-signature' : '' %>>
  <div class="post-signature__meta">
    <p class="post-signature__author"><%= page.signature || (theme.author && theme.author.name) || config.author %></p>
    <% if (withSlip) { %>
    <div class="post-signature__slip">
      <span class="post-ci__petal" aria-hidden="true"></span>
      <%- partial('_partial/poem-slip') %>
    </div>
    <% } %>
    <% if (written) { %><time datetime="<%= date(written, 'YYYY-MM-DD') %>"><%- partial('_partial/han-date', {value: written}) %></time><% } %>
  </div>
  <% if (showSeal) { %><%- render_seal(text, style, 60, 'seal--signature') %><% } %>
</div>

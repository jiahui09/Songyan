<%
  var isCi = typeof variant !== 'undefined' && variant === 'ci';
  var labels = theme.labels;
  var categories = page.categories && page.categories.length ? page.categories.toArray() : [];
  var eyebrow = page.header || page.cipai || (categories[0] && categories[0].name) || (isCi ? theme.archive.categories.ci : labels.post);
  var tags = page.tags && page.tags.length ? page.tags.toArray() : [];
%>
<main class="site-main site-main--narrow" id="reading-main">
  <article class="<%= isCi ? 'post-ci' : 'essay-article' %>">
    <header class="<%= isCi ? 'post-ci__header' : 'essay-header' %>">
      <p class="<%= isCi ? 'post-ci__cipai-badge' : 'post-detail__eyebrow' %>"><%= eyebrow %></p>
      <h1 class="post-title enter"><%= page.title || config.title %></h1>
      <div class="<%= isCi ? 'post-card__meta post-card__meta--center' : 'essay-meta-strip' %>">
        <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY年MM月DD日') %></time>
        <% if (categories.length || isCi) { %><span class="meta-separator" aria-hidden="true">·</span><span><%= isCi ? theme.archive.categories.ci : categories[0].name %></span><% } %>
        <% if (isCi && page.rhyme) { %><span class="meta-separator" aria-hidden="true">·</span><span><%= page.rhyme %></span><% } %>
        <% ['location', 'weather', 'mood'].forEach(function (key) { if (page[key]) { %><span class="meta-separator" aria-hidden="true">·</span><span class="essay-meta-item"><span class="essay-meta-label"><%= labels[key] %>：</span><%= page[key] %></span><% } }); %>
        <% if (tags.length) { %><span class="meta-separator" aria-hidden="true">·</span><span class="post-meta__tags"><% tags.forEach(function (tag) { %><span class="post-meta__tag-item">#<%= tag.name %></span><% }); %></span><% } %>
      </div>
    </header>
    <% if (isCi) { %>
    <div class="post-ci__body-horizontal"><%- partial('_partial/content', {content: page.content || ''}) %></div>
    <% if (Array.isArray(page.annotations) && page.annotations.length) { %>
    <details class="poem-annotations"><summary><%= labels.annotations %></summary><% page.annotations.forEach(function (note) { %><p><strong><%= note.word %></strong>：<%= note.meaning %></p><% }); %></details>
    <% } %>
    <% } else { %>
    <div class="essay-body reading-body<%= page.literary === true ? ' reading-body--literary' : '' %>"><%- partial('_partial/content', {content: page.content || ''}) %></div>
    <% } %>
    <%- partial('_partial/signature') %>
    <% if (isCi && theme.ci && theme.ci.share) { %><%- partial('_partial/poem-slip') %><% } %>
  </article>
</main>

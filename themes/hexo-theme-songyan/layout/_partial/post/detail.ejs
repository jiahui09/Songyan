<%
  var isCi = typeof variant !== 'undefined' && variant === 'ci';
  var labels = theme.labels;
  var ciCfg = theme.ci || {};
  var categories = page.categories && page.categories.length ? page.categories.toArray() : [];
  var eyebrow = page.header || page.cipai || (categories[0] && categories[0].name) || (isCi ? theme.archive.categories.ci : labels.post);
  var author = page.signature || (theme.author && theme.author.name) || config.author;
  var written = page.date || page.updated;
  var epigraph = page.epigraph || page.lead || page.subtitle || '';
  var verticalCi = isCi && (page.poetry_layout === 'vertical' || (page.poetry_layout !== 'horizontal' && ciCfg.vertical_desktop !== false));
%>
<main class="site-main site-main--narrow site-main--reading" id="reading-main">
  <article class="<%= isCi ? 'post-ci' : 'essay-article' %>">
    <div class="reading-dock-zone">
      <header class="<%= isCi ? 'post-ci__header' : 'essay-header' %> reading-mast">
        <div class="reading-mast__cluster">
          <p class="<%= isCi ? 'post-ci__cipai-badge' : 'post-detail__eyebrow' %>"><%= eyebrow %></p>
          <h1 class="post-title"><%= page.title || config.title %></h1>
          <div class="reading-mast__details">
          <div class="reading-mast__meta">
            <% if (author) { %><span class="reading-mast__author"><%= author %></span><% } %>
            <% if (written) { %><time datetime="<%= date(written, 'YYYY-MM-DD') %>"><%- partial('_partial/han-date', {value: written}) %></time><% } %>
            <% if (!isCi && categories.length && categories[0].name !== eyebrow) { %><span><%= categories[0].name %></span><% } %>
            <% if (!isCi) { ['location', 'weather', 'mood'].forEach(function (key) { if (page[key]) { %><span class="essay-meta-item"><span class="essay-meta-label"><%= labels[key] %>：</span><%= page[key] %></span><% } }); } %>
            <% if (isCi && page.rhyme) { %><span class="post-ci__rhyme"><%= page.rhyme %></span><% } %>
          </div>
          <p class="reading-mast__epigraph"<% if (!epigraph) { %> aria-hidden="true"<% } %>><%= epigraph %></p>
          </div>
        </div>
      </header>
      <div class="reading-head-space" aria-hidden="true"></div>
    </div>
    <div class="reading-scene">
    <div class="reading-body-anchor" id="reading-body" tabindex="-1">
      <% if (isCi) { %>
      <div class="post-ci__stage<%= verticalCi ? ' post-ci__stage--columns' : '' %>"<%= verticalCi ? ' data-ci-columns' : '' %>>
        <div class="post-ci__body-horizontal<%= verticalCi ? ' post-ci__body--vertical' : '' %>" data-ci-body>
          <div class="post-ci__verses"><%- partial('_partial/content', {content: page.content || ''}) %></div>
          <%- partial('_partial/signature', {variant: 'vertical', slip: !!ciCfg.share}) %>
        </div>
      </div>
      <% } else {
        var marginNotes = Array.isArray(page.margin_notes) ? page.margin_notes : [];
      %>
      <div class="essay-layout">
        <div class="essay-body reading-body<%= page.literary === true ? ' reading-body--literary' : '' %>"><%- partial('_partial/content', {content: page.content || ''}) %></div>
        <% if (marginNotes.length) { %>
        <aside class="essay-margin" aria-label="<%= labels.margin_notes || '旁批' %>">
          <span class="essay-margin__ornament" aria-hidden="true"></span>
          <% marginNotes.forEach(function (note, index) {
            var anchor = note.anchor || ('essay-note-' + (index + 1));
            var body = note.text || note;
          %>
          <p class="essay-margin__note" id="margin-<%= index + 1 %>">
            <a href="#<%= anchor %>"><%= body %></a>
          </p>
          <% }); %>
        </aside>
        <% } %>
      </div>
      <% } %>
    </div>
    <footer class="post-ending">
    <% if (!isCi) { %><%- partial('_partial/signature') %><% } %>
    </footer>
    <%- partial('_partial/comments') %>
    </div>
  </article>
</main>

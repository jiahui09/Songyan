  <!-- 页头 Header（印前名后） -->
  <header class="site-header">
    <div class="site-header__inner">
      <a href="<%= url_for('/') %>" class="site-header__brand" title="<%= theme.labels.back_to_home %>">
        <% if (theme.seal && theme.seal.enable && theme.seal.locations && theme.seal.locations.navbar) { %>
        <!-- 金石印章：构建期由 render_seal 生成纯矢量 SVG（崩刃/飞白/砂眼走蒙版剪切） -->
        <%- render_seal(theme.seal.text, theme.seal.style, theme.seal.size, 'site-header__seal-gen') %>
        <% } %>
        <div class="site-header__title-wrap">
          <span class="site-header__title"><%= config.title %></span>
          <span class="site-header__title-line"></span>
        </div>
      </a>

      <!-- 导航 Links -->
      <nav aria-label="全局导航">
        <ul class="site-header__nav">
          <% Object.keys(theme.menu).forEach(function (label) { %>
          <li><a href="<%= url_for(theme.menu[label]) %>" class="site-header__nav-link"><%= label %></a></li>
          <% }); %>
        </ul>
      </nav>
    </div>
  </header>

  <!-- 页头 Header（印前名后） -->
  <header class="site-header">
    <div class="site-header__inner">
      <a href="<%= url_for('/') %>" class="site-header__brand" title="<%= theme.labels.back_to_home %>">
        <% if (theme.seal && theme.seal.enable && theme.seal.locations && theme.seal.locations.navbar) { %>
        <!-- 金石印章：构建期由 render_seal 生成纯矢量 SVG（崩刃/飞白/砂眼走蒙版剪切） -->
        <%- render_seal(theme.seal.text, theme.seal.style, theme.seal.size, is_home() && !(page.current > 1) ? 'site-header__seal-gen seal--stamp' : 'site-header__seal-gen') %>
        <% } %>
        <span class="site-header__title"><%= config.title %></span>
      </a>

      <!-- 导航 Links -->
      <nav aria-label="全局导航">
        <ul class="site-header__nav">
          <% Object.keys(theme.menu).forEach(function (label) {
            var href = url_for(theme.menu[label]);
            var current = url_for('/' + String(page.path || '').replace(/index\.html$/, ''));
            var active = href === current
              || (theme.menu[label] === '/' && is_home() && !(page.current > 1))
              || (theme.menu[label] === '/archives/' && (is_archive() || is_category() || is_tag()))
              || (theme.menu[label] === '/about/' && (page.layout === 'about' || page.path === 'about/index.html'));
          %>
          <li><a href="<%= href %>" class="site-header__nav-link<%= active ? ' site-header__nav-link--active' : '' %>"<% if (active) { %> aria-current="page"<% } %>><%= label %></a></li>
          <% }); %>
        </ul>
      </nav>
    </div>
  </header>

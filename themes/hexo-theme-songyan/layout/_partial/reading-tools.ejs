<template id="reading-code-template"><div class="reading-code__tools"><span class="reading-code__language" data-reading-language></span><button type="button" data-reading-copy data-done="<%= theme.labels.code_copied %>" data-failed="<%= theme.labels.code_failed %>" aria-live="polite"><%= theme.labels.code_copy %></button><button type="button" data-reading-toggle data-expand="<%= theme.labels.code_expand %>" data-collapse="<%= theme.labels.code_collapse %>" aria-expanded="false"><%= theme.labels.code_expand %></button></div></template>

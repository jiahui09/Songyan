<main class="site-main site-main--narrow" id="reading-main">
  <article class="page-about">
    <header class="page-about__header">
      <div class="page-about__brand">
        <% if (theme.seal && theme.seal.enable) { %><%- render_seal(undefined, undefined, 48, 'seal--brand') %><% } %>
        <h1 class="page-about__name"><%= theme.author.name || config.author %></h1>
      </div>
      <p class="page-about__tagline"><%= theme.about.tagline %></p>
    </header>
    <div class="page-content reading-body"><% if (page.content) { %><%- partial('_partial/content', {content: page.content}) %><% } else { %><p><%= theme.about.introduction %></p><h2><%= theme.about.heading %></h2><p><%= theme.about.description %></p><% } %></div>
    <%- partial('_partial/signature') %>
  </article>
</main>
